# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5440
DB_USER=hotel_user
DB_PASSWORD=hotel_pass
DB_NAME=hotel_booking

# Business Rules
HOLD_DURATION_MINUTES=10
PAYMENT_SIMULATOR_DECLINE_RATE=0.2

# SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Booking" <noreply@hotel.com>
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
